<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_fail_always" model="ir.cron">
        <field name="name">BP-425 probe: always fails</field>
        <field name="model_id" ref="model_bp425_probe"/>
        <field name="state">code</field>
        <field name="code">model._cron_fail_always()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="numbercall">-1</field>
        <field name="nextcall" eval="(DateTime.now() + relativedelta(years=10)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
</odoo>
