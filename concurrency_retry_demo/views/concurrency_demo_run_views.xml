<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="concurrency_demo_run_view_list" model="ir.ui.view">
        <field name="name">concurrency.demo.run.list</field>
        <field name="model">concurrency.demo.run</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="id"/>
                <field name="create_date"/>
                <field name="scenario_id"/>
                <field name="variant"/>
                <field name="channel"/>
                <field name="outcome" widget="badge"
                       decoration-success="outcome == 'committed'"
                       decoration-danger="outcome == 'failed'"
                       decoration-warning="outcome in ('partial', 'running')"/>
                <field name="request_count"/>
                <field name="attempt_count"/>
                <field name="retry_count"/>
                <field name="external_call_count"/>
                <field name="note" optional="show"/>
            </list>
        </field>
    </record>

    <record id="concurrency_demo_run_view_form" model="ir.ui.view">
        <field name="name">concurrency.demo.run.form</field>
        <field name="model">concurrency.demo.run</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="scenario_id"/>
                            <field name="variant"/>
                            <field name="channel"/>
                            <field name="outcome"/>
                            <field name="note"/>
                        </group>
                        <group>
                            <field name="request_count"/>
                            <field name="attempt_count"/>
                            <field name="retry_count"/>
                            <field name="external_call_count"/>
                            <field name="value_before"/>
                            <field name="value_after"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Attempts" name="attempts">
                            <field name="attempt_ids">
                                <list decoration-success="state == 'committed'"
                                      decoration-danger="state == 'rolled_back'">
                                    <field name="request_no"/>
                                    <field name="attempt_no"/>
                                    <field name="offset_ms"/>
                                    <field name="duration_ms"/>
                                    <field name="state"/>
                                    <field name="error_name"/>
                                    <field name="pgcode"/>
                                    <field name="wait_ms"/>
                                    <field name="note"/>
                                    <field name="retry_log" optional="hide"/>
                                    <field name="thread_name" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="External calls" name="external_calls">
                            <field name="external_call_ids">
                                <list decoration-muted="is_duplicate">
                                    <field name="received_at"/>
                                    <field name="attempt_no"/>
                                    <field name="channel"/>
                                    <field name="payload"/>
                                    <field name="idempotency_key"/>
                                    <field name="is_duplicate"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="concurrency_demo_run_view_search" model="ir.ui.view">
        <field name="name">concurrency.demo.run.search</field>
        <field name="model">concurrency.demo.run</field>
        <field name="arch" type="xml">
            <search>
                <field name="scenario_id"/>
                <field name="variant"/>
                <group>
                    <filter name="group_scenario" string="Scenario" context="{'group_by': 'scenario_id'}"/>
                    <filter name="group_channel" string="Channel" context="{'group_by': 'channel'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="concurrency_demo_run_action" model="ir.actions.act_window">
        <field name="name">Runs</field>
        <field name="res_model">concurrency.demo.run</field>
        <field name="path">retry-demo-runs</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
